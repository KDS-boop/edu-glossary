{
  "mcp": {
    "servers": {
      "bing-webmaster": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@isiahw1/mcp-server-bing-webmaster@latest"
        ],
        "environment": {
          "BING_WEBMASTER_API_KEY": "${BING_WEBMASTER_API_KEY}"
        }
      }
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:FIRECRAWL_API_KEY}"
      }
    }
  }
}