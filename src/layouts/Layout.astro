---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, any>;
  breadcrumbs?: Array<{ label: string; href: string }>;
  publishDate?: Date;
  modifiedDate?: Date;
  author?: string;
  noindex?: boolean;
  ogImageAlt?: string;
}
const {
  title,
  description = 'Explore clear technology definitions and practical guides on AI, cybersecurity, blockchain, cloud computing, and software development.',
  image,
  type = 'website',
  schema,
  breadcrumbs,
  publishDate,
  modifiedDate,
  author,
  noindex = false,
  ogImageAlt,
} = Astro.props;

const siteName = 'EduGlossary';
const titleSuffix = ` | ${siteName}`;
const titleWithoutSiteName = title.endsWith(titleSuffix) ? title.slice(0, -titleSuffix.length).trim() : title.trim();
const maxDocumentTitleLength = 60;
const maxTitleBaseLength = maxDocumentTitleLength - titleSuffix.length;
const shortenedTitle = titleWithoutSiteName.length > maxTitleBaseLength
  ? `${titleWithoutSiteName.slice(0, maxTitleBaseLength - 1).trimEnd().replace(/[\s—–:;,.-]+$/, '')}…`
  : titleWithoutSiteName;
const documentTitle = `${shortenedTitle}${titleSuffix}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = image ? new URL(image, Astro.site) : new URL('/images/og-default.svg', Astro.site);
const googleTagId = 'GT-PJ46S7C5';
const ga4MeasurementId = 'G-F3Z7H2NXEG';

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 1 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: crumb.label,
    item: new URL(crumb.href, Astro.site).toString(),
  })),
} : null;

const schemas = [schema, breadcrumbSchema].filter(Boolean);
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline data-cfasync="false" src="https://5gvci.com/act/files/tag.min.js?z=12211775" async></script>
    <script is:inline data-cfasync="false" data-zone="12246903" src="https://al5sm.com/tag.min.js" async></script>
    <script is:inline data-cfasync="false" data-google-tag-id={googleTagId} data-ga4-id={ga4MeasurementId}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }

      // Keep optional Google storage denied; GA4 receives restricted cookieless signals.
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'denied',
        personalization_storage: 'denied',
        security_storage: 'granted'
      });
      gtag('set', 'ads_data_redaction', true);

      (function () {
        const currentScript = document.currentScript;
        const googleTagId = currentScript && currentScript.getAttribute('data-google-tag-id');
        const analyticsMeasurementId = currentScript && currentScript.getAttribute('data-ga4-id');
        if (!googleTagId || !analyticsMeasurementId) return;

        window.gtag('js', new Date());
        window.gtag('config', googleTagId, { send_page_view: false });
        window.gtag('event', 'page_view', {
          send_to: analyticsMeasurementId,
          page_path: window.location.pathname
        });

        const script = document.createElement('script');
        script.async = true;
        script.setAttribute('data-cfasync', 'false');
        script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(googleTagId);
        (document.head || document.documentElement).appendChild(script);
      })();
    </script>
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icon-48x48.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/icon-64x64.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0d9488" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    {ogImageURL && <meta property="og:image:width" content="1200" />}
    {ogImageURL && <meta property="og:image:height" content="630" />}
    {ogImageURL && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <meta name="twitter:site" content="@eduglossary" />

    {author && <meta name="author" content={author} />}
    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}

    {schemas.length > 0 && schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    <link rel="alternate" type="application/rss+xml" title="EduGlossary RSS" href="/rss.xml" />
    <link id="pagefind-component-styles" href="/pagefind/pagefind-component-ui.css" rel="stylesheet" media="print" />
    <script is:inline defer>
      const loadPagefindStyles = () => {
        const link = document.getElementById('pagefind-component-styles');
        if (link) link.media = 'all';
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadPagefindStyles, { once: true });
      } else {
        loadPagefindStyles();
      }
    </script>
    <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
    <script is:inline src="/pagefind-enhancements.js" defer></script>
    <script is:inline src="/pagefind-analytics.js" defer></script>
  </head>
  <body>
    <pagefind-config instance="header" base-url="/" excerpt-length="15"></pagefind-config>
    <Header />
    <main id="main-content" class="container" style="padding-block: 2.5rem;" data-pagefind-body>
      <slot />
    </main>
    <Footer />
  </body>
</html>
