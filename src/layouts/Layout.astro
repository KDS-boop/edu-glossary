---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, any>;
  breadcrumbs?: Array<{ label: string; href: string }>;
  publishDate?: Date;
  modifiedDate?: Date;
  author?: string;
  noindex?: boolean;
  ogImageAlt?: string;
}
const {
  title,
  description = 'Learn technology terms and articles — explained clearly.',
  image,
  type = 'website',
  schema,
  breadcrumbs,
  publishDate,
  modifiedDate,
  author,
  noindex = false,
  ogImageAlt,
} = Astro.props;

const siteName = 'EduGlossary';
const documentTitle = title.endsWith(` | ${siteName}`) ? title : `${title} | ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = image ? new URL(image, Astro.site) : new URL('/images/og-default.svg', Astro.site);
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const ga4MeasurementId = 'G-F3Z7H2NXEG';
const clarityProjectId = 'ymmigfd0w2';

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 1 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: crumb.label,
    item: new URL(crumb.href, Astro.site).toString(),
  })),
} : null;

const schemas = [schema, breadcrumbSchema].filter(Boolean);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-adsense-account" content="ca-pub-4202775507431567" />
    <script is:inline data-cfasync="false" data-gtm-id={gtmId} data-ga4-id={ga4MeasurementId} data-clarity-id={clarityProjectId}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }

      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'denied',
        personalization_storage: 'denied',
        security_storage: 'granted',
        wait_for_update: 2000,
      });
      gtag('set', 'ads_data_redaction', true);

      // Load GTM only after at least one relevant CookieYes category is granted.
      // Tags may still emit cookieless Consent Mode pings for denied categories;
      // strict blocking of individual tags must also be configured in the GTM container.
      (function () {
        const currentScript = document.currentScript;
        const containerId = currentScript && currentScript.getAttribute('data-gtm-id');
        const analyticsMeasurementId = currentScript && currentScript.getAttribute('data-ga4-id');
        const clarityId = currentScript && currentScript.getAttribute('data-clarity-id');

        let gtmLoaded = false;
        let lastConsent = null;
        let clarityLoaded = false;

        function syncClarityConsent(analytics, advertising) {
          if (!clarityLoaded || typeof window.clarity !== 'function') return;
          window.clarity('consentv2', {
            ad_Storage: advertising ? 'granted' : 'denied',
            analytics_Storage: analytics ? 'granted' : 'denied'
          });
        }

        function loadClarity(analytics, advertising) {
          if (!clarityId || !analytics || clarityLoaded) return;

          // Create the queue only after Analytics consent; no Clarity request is
          // made for visitors who reject or have not yet chosen Analytics.
          window.clarity = window.clarity || function () {
            (window.clarity.q = window.clarity.q || []).push(arguments);
          };
          clarityLoaded = true;
          syncClarityConsent(analytics, advertising);

          const script = document.createElement('script');
          script.async = true;
          script.setAttribute('data-cfasync', 'false');
          script.src = 'https://www.clarity.ms/tag/' + encodeURIComponent(clarityId);
          (document.head || document.documentElement).appendChild(script);
        }

        let ga4Loaded = false;

        function loadGA4() {
          if (!analyticsMeasurementId || ga4Loaded) return;
          ga4Loaded = true;
          window.gtag('js', new Date());
          window.gtag('config', analyticsMeasurementId);

          const script = document.createElement('script');
          script.async = true;
          script.setAttribute('data-cfasync', 'false');
          script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(analyticsMeasurementId);
          (document.head || document.documentElement).appendChild(script);
        }

        function applyConsent(categories) {
          if (!categories || typeof categories !== 'object') return;

          const isGranted = (value) => value === true || value === 1 || (typeof value === 'string' && ['yes', 'true', 'granted'].includes(value.toLowerCase()));
          const analytics = isGranted(categories.analytics);
          const advertising = isGranted(categories.advertisement);
          const functional = isGranted(categories.functional);

          const permitted = analytics || advertising;
          const consentChanged = lastConsent !== null && (
            lastConsent.analytics !== analytics ||
            lastConsent.advertising !== advertising ||
            lastConsent.functional !== functional
          );

          window.gtag('consent', 'update', {
            analytics_storage: analytics ? 'granted' : 'denied',
            ad_storage: advertising ? 'granted' : 'denied',
            ad_user_data: advertising ? 'granted' : 'denied',
            ad_personalization: advertising ? 'granted' : 'denied',
            functionality_storage: functional ? 'granted' : 'denied',
            personalization_storage: functional ? 'granted' : 'denied'
          });

          // GA4 is loaded directly only after Analytics consent; do not rely on GTM.
          if (analytics) loadGA4();

          // Sync Clarity's current consent before any reload. This also lets
          // Clarity clear its cookies when a visitor withdraws Analytics consent.
          if (clarityLoaded) {
            syncClarityConsent(analytics, advertising);
          } else if (analytics) {
            loadClarity(analytics, advertising);
          }

          // Reinitialize the page after any consent change so tags that were
          // previously blocked or allowed are evaluated against the new state.
          if (gtmLoaded && consentChanged) {
            window.location.reload();
            return;
          }

          if (containerId && permitted && !gtmLoaded) {
            gtmLoaded = true;
            window.dataLayer.push({
              'gtm.start': new Date().getTime(),
              event: 'gtm.js'
            });
            const firstScript = document.getElementsByTagName('script')[0];
            const script = document.createElement('script');
            script.async = true;
            script.setAttribute('data-cfasync', 'false');
            script.src = 'https://www.googletagmanager.com/gtm.js?id=' +
              encodeURIComponent(containerId) + '&l=dataLayer';
            firstScript.parentNode.insertBefore(script, firstScript);
          }

          lastConsent = { analytics, advertising, functional };
        }

        function onBannerLoad(event) {
          const detail = event && event.detail;
          if (detail && detail.categories) applyConsent(detail.categories);
        }

        function onConsentUpdate(event) {
          const detail = event && event.detail;
          if (!detail) return;
          if (detail.categories) {
            applyConsent(detail.categories);
          } else if (Array.isArray(detail.accepted)) {
            applyConsent({
              analytics: detail.accepted.includes('analytics'),
              advertisement: detail.accepted.includes('advertisement'),
              functional: detail.accepted.includes('functional')
            });
          }
        }

        document.addEventListener('cookieyes_banner_load', onBannerLoad);
        document.addEventListener('cookieyes_consent_update', onConsentUpdate);

        // Fallback for a returning visitor if the CMP load event fired before
        // these listeners were registered. No cookie or unknown state fails closed.
        try {
          const match = document.cookie.match(/(?:^|;\s*)cookieyes-consent=([^;]*)/);
          if (match) {
            const state = {};
            decodeURIComponent(match[1]).split(',').forEach(function (item) {
              const parts = item.split(':');
              if (parts.length === 2) {
                state[parts[0].trim()] = parts[1].trim().toLowerCase() === 'yes';
              }
            });
            if (state.consent === true) applyConsent(state);
          }
        } catch (_) {
          // Consent parsing failures intentionally leave GTM blocked.
        }
      })();
    </script>
    <script is:inline async data-cfasync="false" src="https://cdn-cookieyes.com/client_data/ce98d11434507f560f9a482b3f1d9796/script.js"></script>
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icon-48x48.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/icon-64x64.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0d9488" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    {ogImageURL && <meta property="og:image:width" content="1200" />}
    {ogImageURL && <meta property="og:image:height" content="630" />}
    {ogImageURL && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <meta name="twitter:site" content="@eduglossary" />

    {author && <meta name="author" content={author} />}
    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}

    {schemas.length > 0 && schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    <link rel="alternate" type="application/rss+xml" title="EduGlossary RSS" href="/rss.xml" />
    <link id="pagefind-component-styles" href="/pagefind/pagefind-component-ui.css" rel="stylesheet" media="print" />
    <script is:inline defer>
      const loadPagefindStyles = () => {
        const link = document.getElementById('pagefind-component-styles');
        if (link) link.media = 'all';
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadPagefindStyles, { once: true });
      } else {
        loadPagefindStyles();
      }
    </script>
    <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
    <script is:inline src="/pagefind-enhancements.js" defer></script>
    <script is:inline src="/pagefind-analytics.js" defer></script>
  </head>
  <body>
    <pagefind-config instance="header" base-url="/" excerpt-length="15"></pagefind-config>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content" class="container" style="padding-block: 2.5rem;" data-pagefind-body>
      <slot />
    </main>
    <Footer />
  </body>
</html>

