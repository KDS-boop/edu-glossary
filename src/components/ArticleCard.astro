---
import { slugify } from '../utils/slugify';
import { getCategoryColor } from '../utils/categoryColors';
import { getCategoryIcon } from '../utils/categoryIcons';
import { getAuthorBySlug } from '../data/authors';

interface Props {
  title: string;
  description: string;
  category: string;
  author: string;
  publishedDate: Date;
  slug: string;
  featured?: boolean;
}
const { title, description, category, author, publishedDate, slug, featured = false } = Astro.props;
const dateLabel = publishedDate.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' });
const { bg, text } = getCategoryColor(category);
const icon = getCategoryIcon(category);

const authorData = getAuthorBySlug(author);
const authorName = authorData?.name || author;
const authorSlug = authorData?.slug || slugify(author);
---
<div class="card" {featured && 'data-featured'}>
  <div class="card-accent" style={`background: ${text};`}></div>
  <div class="card-body">
    <a class="badge" href={`/articles/categories/${slugify(category)}/`} style={`background: ${bg}; color: ${text};`}>
      <span set:html={icon}></span>
      {category}
    </a>
    <h3 class="card-title"><a href={`/articles/${slug}/`}>{title}</a></h3>
    <p class="card-excerpt">{description}</p>
    <div class="card-meta">
      <span class="card-meta-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        <a href={`/authors/${authorSlug}/`} style="color: inherit; text-decoration: none;">{authorName}</a>
      </span>
      <span class="card-meta-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        {dateLabel}
      </span>
    </div>
    <span class="card-readmore">
      Read article
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </span>
  </div>
</div>

<style>
  [data-featured] .card-body {
    padding: 1.75rem;
  }
  [data-featured] .card-title {
    font-size: 1.25rem;
  }
  [data-featured] .card-excerpt {
    font-size: 1rem;
    -webkit-line-clamp: 4;
  }
  [data-featured] .badge {
    font-size: 0.75rem;
    padding: 0.3rem 0.75rem;
  }
</style>
