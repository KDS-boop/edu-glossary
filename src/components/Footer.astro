---
const year = new Date().getFullYear();

const navMain = [
  { label: 'Home', href: '/' },
  { label: 'Learn', href: '/learn/' },
  { label: 'Glossary', href: '/glossary/' },
  { label: 'Articles', href: '/articles/' },
  { label: 'About', href: '/about/' },
  { label: 'Disclaimer', href: '/disclaimer/' },
];

const topics = [
  { label: 'Blockchain & Decentralization', href: '/learn/blockchain/' },
  { label: 'Cloud Computing', href: '/learn/cloud-computing/' },
  { label: 'Software Development', href: '/learn/software-development/' },
  { label: 'Cybersecurity', href: '/learn/cybersecurity/' },
  { label: 'AI & Data', href: '/learn/ai-and-data/' },
  { label: 'Technology', href: '/learn/' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="footer-logo" href="/">
          <span>E</span>duGlossary
        </a>
        <p class="footer-desc">Learn technology terms and articles — explained clearly for everyone.</p>
        <p class="footer-author"><a href="/authors/eduglossary-team/">EduGlossary Team</a></p>
      </div>

      <div class="footer-links">
        <h3>Navigation</h3>
        <ul>
          {navMain.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-links">
        <h3>Topics</h3>
        <ul>
          {topics.map((topic) => (
            <li><a href={topic.href}>{topic.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} EduGlossary. All rights reserved.</p>
      <p>Made with care for learners everywhere.</p>
    </div>
  </div>
</footer>
