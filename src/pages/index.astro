---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import GlossaryCard from '../components/GlossaryCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCategoryColor } from '../utils/categoryColors';
import { getCategoryIcon } from '../utils/categoryIcons';
import { slugify } from '../utils/slugify';
import { hubs } from '../data/hubs';
import { getAuthorBySlug } from '../data/authors';

const allGlossary = await getCollection('glossary');

// Featured glossary: most relatedTerms, tiebreak by updatedDate asc, then term asc
const featuredGlossary = allGlossary.reduce((best, entry) => {
  if (!best) return entry;
  const bestLen = best.data.relatedTerms.length;
  const entryLen = entry.data.relatedTerms.length;
  if (entryLen > bestLen) return entry;
  if (entryLen < bestLen) return best;
  if (entry.data.updatedDate < best.data.updatedDate) return entry;
  if (entry.data.updatedDate > best.data.updatedDate) return best;
  if (entry.data.term < best.data.term) return entry;
  return best;
}, allGlossary[0]);

// Remaining glossary (excluding featured), sorted by updatedDate desc, max 6
const glossaryEntries = allGlossary
  .filter((e) => e.id !== featuredGlossary.id)
  .sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf())
  .slice(0, 6);

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const articles = allArticles
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());

// Featured article: most recent published
const featuredArticle = articles.length > 0 ? articles[0] : null;
const remainingArticles = articles.slice(1, 4);

const categoryMap = new Map<string, number>();
for (const entry of allGlossary) {
  const count = categoryMap.get(entry.data.category) ?? 0;
  categoryMap.set(entry.data.category, count + 1);
}
const topCategories = [...categoryMap.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5);

const siteURL = Astro.site?.toString() || 'https://edu-glossary.pages.dev';
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'EduGlossary',
  url: siteURL,
  description: 'Learn technology terms and articles — explained clearly.',
  inLanguage: 'en',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: new URL('/glossary/?q={search_term_string}', siteURL).toString(),
    },
    'query-input': 'required name=search_term_string',
  },
};
---
<Layout title="Technology Terms & Articles Explained" schema={siteSchema}>
  <section class="hero">
    <h1>Learn Technology Terms, Explained Clearly</h1>
    <p class="hero-subtitle">Glossary and educational articles made easy — updated regularly.</p>
    <div id="hero-search" style="margin-top: 1.5rem;"></div>
    <div class="search-discovery" style="margin-top: 1.25rem;">
      <div class="search-discovery-links">
        {topCategories.slice(0, 4).map(([category]) => (
          <a href={`/glossary/categories/${slugify(category)}/`}>
            <span set:html={getCategoryIcon(category)}></span>
            {category}
          </a>
        ))}
        <a href="/glossary/">Glossary A-Z</a>
        <a href="/articles/">Articles</a>
      </div>
    </div>
  </section>

  {featuredGlossary && (
    <section class="section" aria-labelledby="featured-glossary-heading">
      <h2 id="featured-glossary-heading" class="section-title">Featured Term</h2>
      <a class="card featured-card" href={`/glossary/${featuredGlossary.slug}/`}>
        <div class="card-accent" style={`background: ${getCategoryColor(featuredGlossary.data.category).text};`}></div>
        <div class="card-body">
          <div class="featured-card-top">
            <span class="badge" style={`background: ${getCategoryColor(featuredGlossary.data.category).bg}; color: ${getCategoryColor(featuredGlossary.data.category).text};`}>
              <span set:html={getCategoryIcon(featuredGlossary.data.category)}></span>
              {featuredGlossary.data.category}
            </span>
            <span class="featured-card-letter" aria-label={`Letter ${featuredGlossary.data.letter}`}>{featuredGlossary.data.letter}</span>
          </div>
          <h3 class="featured-card-title">{featuredGlossary.data.term}</h3>
          <p class="featured-card-def">{featuredGlossary.data.shortDefinition}</p>
          {featuredGlossary.data.relatedTerms.length > 0 && (
            <div class="featured-card-related" aria-label="Related terms">
              <span class="muted">Connected to:</span>
              {featuredGlossary.data.relatedTerms.slice(0, 3).map((t: string) => {
                const related = allGlossary.find((e) => e.data.term.toLowerCase() === t.toLowerCase());
                return related ? (
                  <a href={`/glossary/${related.slug}/`} class="related-tag">{t}</a>
                ) : (
                  <span class="related-tag">{t}</span>
                );
              })}
              {featuredGlossary.data.relatedTerms.length > 3 && (
                <span class="muted">+{featuredGlossary.data.relatedTerms.length - 3}</span>
              )}
            </div>
          )}
          <span class="card-readmore">
            View definition
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </span>
        </div>
      </a>
    </section>
  )}

  <section class="section" aria-labelledby="categories-heading">
    <h2 id="categories-heading" class="section-title">Popular Categories</h2>
    <div class="category-grid">
      {topCategories.map(([category, count]) => {
        const { bg, text } = getCategoryColor(category);
        const icon = getCategoryIcon(category);
        return (
          <a class="category-card" href={`/glossary/categories/${slugify(category)}/`} style={`border: 2px solid ${text};`}>
            <div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
              <span style={`display: inline-flex; color: ${text};`} set:html={icon}></span>
              <span style={`font-weight: 600; color: ${text};`}>{category}</span>
            </div>
            <p class="muted" style="margin-top: 0.5rem;">{count} terms</p>
          </a>
        );
      })}
    </div>
  </section>

  <section class="section" aria-labelledby="learn-heading">
    <div class="section-header">
      <h2 id="learn-heading" class="section-title">Learn Topics</h2>
      <a href="/learn/" class="section-link">View all &rarr;</a>
    </div>
    <div class="hub-home-grid">
      {hubs.map((hub) => {
        const hubCatMap = {
          'blockchain': 'Blockchain',
          'cloud-computing': 'Cloud Computing',
          'software-development': 'Software Development',
          'cybersecurity': 'Cybersecurity',
          'ai-and-data': 'AI & Data',
        };
        const catName = hubCatMap[hub.slug] || hub.title;
        const { text } = getCategoryColor(catName);
        return (
          <a class="hub-home-link" href={`/learn/${hub.slug}/`} style={`border-left: 3px solid ${text};`}>
            <span class="hub-home-title">{hub.title}</span>
            <span class="muted" style="font-size: 0.8rem;">{hub.glossarySlugs.length} terms</span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="section" aria-labelledby="glossary-heading">
    <div class="section-header">
      <h2 id="glossary-heading" class="section-title">Latest Terms</h2>
      <a href="/glossary/" class="section-link">View all &rarr;</a>
    </div>
    <div class="grid">
      {glossaryEntries.map((entry) => (
        <GlossaryCard
          term={entry.data.term}
          shortDefinition={entry.data.shortDefinition}
          category={entry.data.category}
          letter={entry.data.letter}
          relatedCount={entry.data.relatedTerms.length}
          slug={entry.slug}
        />
      ))}
    </div>
  </section>

  {featuredArticle && (
    <section class="section" aria-labelledby="articles-heading">
      <div class="section-header">
        <h2 id="articles-heading" class="section-title">Latest Articles</h2>
        {remainingArticles.length > 0 && (
          <a href="/articles/" class="section-link">View all &rarr;</a>
        )}
      </div>
      <a class="card featured-card" href={`/articles/${featuredArticle.slug}/`}>
        <div class="card-accent" style={`background: ${getCategoryColor(featuredArticle.data.category).text};`}></div>
        <div class="card-body">
          <div class="featured-card-top">
            <span class="badge" style={`background: ${getCategoryColor(featuredArticle.data.category).bg}; color: ${getCategoryColor(featuredArticle.data.category).text};`}>
              <span set:html={getCategoryIcon(featuredArticle.data.category)}></span>
              {featuredArticle.data.category}
            </span>
          </div>
          <h3 class="featured-card-title">{featuredArticle.data.title}</h3>
          <p class="featured-card-def">{featuredArticle.data.description}</p>
          <div class="card-meta">
            <span class="card-meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              {(() => { const a = getAuthorBySlug(featuredArticle.data.author); return a ? <a href={`/authors/${a.slug}/`} style="color: inherit; text-decoration: none;">{a.name}</a> : featuredArticle.data.author; })()}
            </span>
            <span class="card-meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              {featuredArticle.data.publishedDate.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}
            </span>
          </div>
          <span class="card-readmore">
            Read article
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </span>
        </div>
      </a>
      {remainingArticles.length > 0 && (
        <div class="grid" style="margin-top: 1.25rem;">
          {remainingArticles.map((post) => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              category={post.data.category}
              author={post.data.author}
              publishedDate={post.data.publishedDate}
              slug={post.slug}
            />
          ))}
        </div>
      )}
    </section>
  )}
</Layout>

<script is:inline>
  window.addEventListener('load', () => {
    if (window.__eduglossary && window.__eduglossary.search) {
      window.__eduglossary.search.init('#hero-search', {
        showImages: false,
        excerptLength: 15
      });
    }
  });
</script>

<style>
  .hero {
    text-align: center;
    padding: 2rem 0 3rem;
  }
  
  .hero h1 {
    font-size: 2rem;
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  
  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--color-muted);
    max-width: 600px;
    margin: 0 auto;
  }
  
  .section {
    margin-top: 3rem;
  }
  
  .section-title {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }
  
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  
  .section-header .section-title {
    margin-bottom: 0;
  }
  
  .section-link {
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
  }
  
  .featured-card {
    display: block;
    text-decoration: none;
  }
  
  .featured-card:hover {
    text-decoration: none;
  }
  
  .featured-card .card-body {
    padding: 1.5rem;
  }
  
  .featured-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  
  .featured-card-letter {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-border);
    line-height: 1;
    user-select: none;
  }
  
  .featured-card-title {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0.6rem 0 0.5rem;
    line-height: 1.3;
  }
  
  .featured-card-title a {
    color: var(--color-text);
    text-decoration: none;
  }
  
  .featured-card-title a:hover {
    color: var(--color-primary);
  }
  
  .featured-card-def {
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }
  
  .featured-card-related {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.75rem;
    font-size: 0.8rem;
  }
  
  .related-tag {
    color: var(--color-primary);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px dashed var(--color-primary);
  }

  .related-tag:hover {
    text-decoration: none;
    border-bottom-style: solid;
  }
  
  .category-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    margin-top: 1rem;
  }
  
  .category-card {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem 1rem;
    text-align: center;
    transition: all 0.15s ease;
    text-decoration: none;
  }
  
  .category-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    border-color: var(--color-primary);
    text-decoration: none;
  }
  
  .category-card h3 {
    margin: 0;
    font-size: 1.1rem;
    color: var(--color-text);
  }

  .hub-home-grid {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }

  .hub-home-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .hub-home-link:hover {
    border-color: var(--color-primary);
    text-decoration: none;
    background: rgba(59, 91, 219, 0.03);
  }

  .hub-home-title {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-text);
  }
  
  @media (max-width: 768px) {
    .hero h1 {
      font-size: 1.5rem;
    }
    
    .hero-subtitle {
      font-size: 1rem;
    }
    
    .category-grid {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    }
    
    .featured-card .card-body {
      padding: 1.25rem;
    }
    
    .featured-card-title {
      font-size: 1.2rem;
    }
    
    .section-header {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
