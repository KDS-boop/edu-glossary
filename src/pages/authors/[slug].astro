---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { authors, getAuthorBySlug } from '../../data/authors';
import { getCategoryColor } from '../../utils/categoryColors';
import { getCategoryIcon } from '../../utils/categoryIcons';

export async function getStaticPaths() {
  return authors.map((author) => ({
    params: { slug: author.slug },
    props: { author },
  }));
}

const { author } = Astro.props;

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const authorArticles = allArticles
  .filter((a) => a.data.author === author.slug)
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());

// Build comprehensive Person schema for E-E-A-T
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  description: author.bio,
  jobTitle: author.role,
  url: new URL(`/authors/${author.slug}/`, Astro.site).toString(),
  ...(author.avatar && { image: new URL(author.avatar, Astro.site).toString() }),
  ...(author.email && { email: author.email }),
  ...(author.sameAs && { sameAs: author.sameAs }),
  ...(author.credentials && {
    credential: author.credentials.map((c) => ({
      '@type': 'EducationalOccupationalCredential',
      name: c,
    })),
  }),
  ...(author.expertise && {
    knowsAbout: author.expertise,
  }),
  ...(author.organization && {
    worksFor: {
      '@type': 'Organization',
      name: author.organization.name,
      url: author.organization.url,
      ...(author.organization.logo && { logo: new URL(author.organization.logo, Astro.site).toString() }),
    },
  }),
  ...(author.publishedWorks && {
    author: author.publishedWorks.map((w) => ({
      '@type': 'ScholarlyArticle',
      name: w.title,
      url: w.url,
      datePublished: w.year.toString(),
    })),
  }),
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: `${author.name} | Authors`,
  description: author.bio,
  mainEntity: personSchema,
};

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Authors', href: '/authors/' },
  { label: author.name, href: `/authors/${author.slug}/` },
];
---
<Layout
  title={author.name}
  description={author.bio}
  schema={pageSchema}
  breadcrumbs={breadcrumbs}
>
  <Breadcrumb items={breadcrumbs} />

  <header class="author-header">
    {author.avatar && (
      <img src={author.avatar} alt="" class="author-avatar" loading="lazy" />
    )}
    <div class="author-meta">
      <h1>{author.name}</h1>
      <p class="author-role">{author.role}</p>
      {author.organization && (
        <a href={author.organization.url} class="author-org" target="_blank" rel="noopener">
          {author.organization.name}
        </a>
      )}
      {author.sameAs && author.sameAs.length > 0 && (
        <div class="author-social">
          {author.sameAs.map((url) => {
            const platform = url.includes('github') ? 'GitHub' : url.includes('twitter') ? 'X' : url.includes('linkedin') ? 'LinkedIn' : 'Profile';
            return <a href={url} class="social-link" target="_blank" rel="noopener" aria-label={platform} title={platform}>
              {platform === 'GitHub' && <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>}
              {platform === 'X' && <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 9.24-3.308.83-7.588-8.654-7.778 8.848-3.314-.83 8.502-9.24-7.228-8.26h3.307l4.291 4.88 4.499-5.377z"/></svg>}
              {platform === 'LinkedIn' && <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>}
            </a>;
          })}
        </div>
      )}
    </div>
  </header>

  <section class="author-about" aria-labelledby="about-heading">
    <h2 id="about-heading">About</h2>
    <p class="author-bio">{author.bio}</p>
    
    {author.experience && (
      <div class="author-experience" style="margin-top: 1.5rem;">
        <h3 style="font-size: 1rem; margin-bottom: 0.5rem;">Experience</h3>
        <p style="color: var(--color-muted); line-height: 1.6;">{author.experience}</p>
      </div>
    )}

    {author.credentials && author.credentials.length > 0 && (
      <div class="author-credentials" style="margin-top: 1.5rem;">
        <h3 style="font-size: 1rem; margin-bottom: 0.5rem;">Credentials & Certifications</h3>
        <ul style="color: var(--color-muted); line-height: 1.8; padding-left: 1.25rem;">
          {author.credentials.map((cred) => <li>{cred}</li>)}
        </ul>
      </div>
    )}

    {author.expertise && author.expertise.length > 0 && (
      <div class="author-expertise" style="margin-top: 1.5rem;">
        <h3 style="font-size: 1rem; margin-bottom: 0.5rem;">Areas of Expertise</h3>
        <div class="expertise-tags" style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
          {author.expertise.map((topic) => (
            <span class="badge" style="background: var(--color-surface); color: var(--color-text); border: 1px solid var(--color-border);">{topic}</span>
          ))}
        </div>
      </div>
    )}
  </section>

  {authorArticles.length > 0 && (
    <section class="author-articles" aria-labelledby="articles-heading">
      <h2 id="articles-heading">Articles by {author.name}</h2>
      <div class="grid">
        {authorArticles.map((article) => {
          const { bg, text } = getCategoryColor(article.data.category);
          const icon = getCategoryIcon(article.data.category);
          return (
            <a class="card" href={`/articles/${article.slug}/`}>
              <div class="card-accent" style={`background: ${text};`}></div>
              <div class="card-body">
                <span class="badge" style={`background: ${bg}; color: ${text};`}>
                  <span set:html={icon}></span>
                  {article.data.category}
                </span>
                <h3 class="card-title">{article.data.title}</h3>
                <p class="card-excerpt">{article.data.description}</p>
                <span class="card-readmore">
                  Read article
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  {author.publishedWorks && author.publishedWorks.length > 0 && (
    <section class="author-works" aria-labelledby="works-heading" style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border);">
      <h2 id="works-heading">Notable Publications</h2>
      <ul style="list-style: none; padding: 0; color: var(--color-muted); line-height: 1.8;">
        {author.publishedWorks.map((work) => (
          <li><a href={work.url} style="color: var(--color-primary);">{work.title}</a> ({work.year})</li>
        ))}
      </ul>
    </section>
  )}
</Layout>

<style>
  .author-role {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .author-about {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .author-about h2 {
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
  }

  .author-bio {
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 65ch;
  }

  .author-header {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .author-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .author-meta {
    flex: 1;
    min-width: 0;
  }

  .author-meta h1 {
    margin-bottom: 0.25rem;
  }

  .author-role {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .author-org {
    font-size: 0.9rem;
    color: var(--color-muted);
    text-decoration: none;
  }

  .author-org:hover {
    color: var(--color-primary);
  }

  .author-social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-muted);
    transition: all 0.15s ease;
  }

  .social-link:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: rgba(59, 91, 219, 0.04);
  }

  [data-theme="dark"] .social-link {
    border-color: var(--color-border);
    color: var(--color-muted);
  }

  [data-theme="dark"] .social-link:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .author-articles {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .author-articles h2 {
    font-size: 1.15rem;
    margin-bottom: 1rem;
  }
</style>
