---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { authors } from '../../data/authors';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Authors', href: '/authors/' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Authors',
  description: 'Meet the editorial team behind EduGlossary and explore their published articles.',
};
---
<Layout title="Authors" description="Meet the editorial team behind EduGlossary and explore their published articles." schema={schema} breadcrumbs={breadcrumbs}>
  <Breadcrumb items={breadcrumbs} />
  <h1>Authors</h1>
  <p class="muted">Meet the people behind the content.</p>

  <div class="grid" style="margin-top: 2rem;">
    {authors.map((author) => {
      const authorArticles = allArticles.filter((a) => a.data.author === author.slug);
      return (
        <a class="card author-card" href={`/authors/${author.slug}/`}>
          <div class="card-body">
            <h2 class="author-card-name">{author.name}</h2>
            <p class="author-card-role">{author.role}</p>
            <p class="author-card-bio">{author.bio}</p>
            <span class="card-readmore">
              {authorArticles.length} article{authorArticles.length !== 1 ? 's' : ''}
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </span>
          </div>
        </a>
      );
    })}
  </div>
</Layout>

<style>
  .author-card {
    display: block;
    text-decoration: none;
  }
  .author-card:hover {
    text-decoration: none;
  }
  .author-card-name {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 0.25rem;
    color: var(--color-text);
  }
  .author-card-role {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .author-card-bio {
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.55;
    margin: 0;
  }
</style>
