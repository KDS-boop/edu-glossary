---
import { getCollectionSorted } from '../../../utils/collections';
import Layout from '../../../layouts/Layout.astro';
import { slugify } from '../../../utils/slugify';
import { getCategoryColor } from '../../../utils/categoryColors';
import { getCategoryIcon } from '../../../utils/categoryIcons';

const entries = await getCollectionSorted('glossary');

const categoryMap = new Map<string, number>();
for (const entry of entries) {
  const count = categoryMap.get(entry.data.category) ?? 0;
  categoryMap.set(entry.data.category, count + 1);
}
const categories = [...categoryMap.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---
<Layout title="Glossary Categories" description="Browse terms by category.">
  <h1>Glossary Categories</h1>
  <p class="muted">Select a category to view related terms.</p>

  <div class="grid" style="margin-top: 1.5rem;">
    {categories.map(([category, count]) => {
      const { text, darkText } = getCategoryColor(category);
      const icon = getCategoryIcon(category);
      return (
        <a class="card category-overview-card" href={`/glossary/categories/${slugify(category)}/`} style={`--cat-text: ${text}; --cat-dark-text: ${darkText};`}>
          <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span class="category-icon" style="display: inline-flex;" set:html={icon}></span>
              <span class="category-title" style="font-weight: 600;">{category}</span>
            </div>
            <p class="muted" style="margin-top: 0.5rem;">{count} terms</p>
          </div>
        </a>
      );
    })}
  </div>
</Layout>

<style>
  .category-overview-card {
    border-left: 4px solid var(--cat-text);
  }
  .category-overview-card .category-icon,
  .category-overview-card .category-title {
    color: var(--cat-text);
  }
  :global([data-theme="dark"]) .category-overview-card {
    border-left-color: var(--cat-dark-text);
  }
  :global([data-theme="dark"]) .category-overview-card .category-icon,
  :global([data-theme="dark"]) .category-overview-card .category-title {
    color: var(--cat-dark-text);
  }
</style>
