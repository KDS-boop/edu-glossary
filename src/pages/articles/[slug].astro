---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { slugify } from '../../utils/slugify';
import { getCategoryColor } from '../../utils/categoryColors';
import { getCategoryIcon } from '../../utils/categoryIcons';
import { getAuthorBySlug } from '../../data/authors';

export async function getStaticPaths() {
  const posts = await getCollection('articles', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const words = post.body.split(/\s+/).length;
const readingTime = Math.max(1, Math.round(words / 200));

const author = getAuthorBySlug(post.data.author);
const authorName = author?.name || post.data.author;
const authorSlug = author?.slug || slugify(post.data.author);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  url: new URL(`/articles/${post.slug}/`, Astro.site).toString(),
  author: {
    '@type': 'Organization',
    name: authorName,
    url: new URL(`/authors/${authorSlug}/`, Astro.site).toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'EduGlossary',
    url: Astro.site?.toString(),
  },
  mainEntityOfPage: new URL(`/articles/${post.slug}/`, Astro.site).toString(),
  datePublished: post.data.publishedDate.toISOString(),
  ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
};

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Articles', href: '/articles/' },
  { label: post.data.title, href: `/articles/${post.slug}/` },
];

// Resolve related glossary terms
const allGlossary = await getCollection('glossary');
const termToEntry = new Map(allGlossary.map((e) => [e.data.term.toLowerCase(), e]));
const relatedGlossary = (post.data.relatedGlossary || [])
  .map((t: string) => {
    const target = termToEntry.get(t.toLowerCase());
    if (!target) return null;
    return { term: t, slug: target.slug, category: target.data.category, shortDefinition: target.data.shortDefinition };
  })
  .filter(Boolean);

// Related articles: same category, excluding self
const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const relatedArticles = allArticles
  .filter((a) => a.slug !== post.slug && (a.data.category === post.data.category || post.data.tags.some((t: string) => a.data.tags.includes(t))))
  .slice(0, 3);
// Optimized title format: "Title — Category | EduGlossary"
const pageTitle = `${post.data.title} — ${post.data.category} Guide`;
const pageDescription = post.data.description;
---
<Layout
  title={pageTitle}
  description={pageDescription}
  type="article"
  image={post.data.coverImage}
  schema={schema}
  breadcrumbs={breadcrumbs}
  publishDate={post.data.publishedDate}
  modifiedDate={post.data.updatedDate}
  author={authorName}
>
  <Breadcrumb items={breadcrumbs} />
  
  <span class="badge" style={`background: ${getCategoryColor(post.data.category).bg}; color: ${getCategoryColor(post.data.category).text}; display: inline-flex; align-items: center; gap: 0.3rem;`}><span style="display: inline-flex;" set:html={getCategoryIcon(post.data.category)}></span><a href={`/articles/categories/${slugify(post.data.category)}/`} style="color: inherit; text-decoration: none;">{post.data.category}</a></span>
  <h1>{post.data.title}</h1>
  <p class="muted">
    By <a href={`/authors/${authorSlug}/`}>{authorName}</a> &middot;
    {post.data.publishedDate.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}
    &middot; {readingTime} min read
  </p>

  {post.data.coverImage && (
    <img
      src={post.data.coverImage}
      alt={`Cover image for article: ${post.data.title}`}
      loading="lazy"
      style="width: 100%; border-radius: 12px; margin: 1rem 0;"
    />
  )}

  <article class="prose" style="margin-top: 1.5rem;">
    <Content />
  </article>

  {post.data.tags.length > 0 && (
    <p style="margin-top: 2rem;">
      {post.data.tags.map((tag: string) => <span class="badge" style="margin-right: 0.4rem;">{tag}</span>)}
    </p>
  )}

  {relatedGlossary.length > 0 && (
    <section class="related-section" aria-labelledby="related-terms-heading">
      <h2 id="related-terms-heading">Related Terms</h2>
      <div class="related-pill-list">
        {relatedGlossary.map((r) => {
          const { bg, text } = getCategoryColor(r.category);
          return (
            <a class="related-pill" href={`/glossary/${r.slug}/`} title={r.shortDefinition}>
              <span class="related-pill-dot" style={`background: ${text};`}></span>
              {r.term}
            </a>
          );
        })}
      </div>
    </section>
  )}

  {relatedArticles.length > 0 && (
    <section class="related-section" aria-labelledby="related-articles-heading">
      <h2 id="related-articles-heading">Related Articles</h2>
      <div class="related-pill-list">
        {relatedArticles.map((a) => (
          <a class="related-pill related-pill--article" href={`/articles/${a.slug}/`} title={a.data.description}>
            {a.data.title}
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>
