---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { slugify } from '../../../utils/slugify';
import { getCategoryColor } from '../../../utils/categoryColors';
import { getCategoryIcon } from '../../../utils/categoryIcons';

const posts = await getCollection('articles', ({ data }) => !data.draft);

const categoryMap = new Map<string, number>();
for (const post of posts) {
  const count = categoryMap.get(post.data.category) ?? 0;
  categoryMap.set(post.data.category, count + 1);
}
const categories = [...categoryMap.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---
<Layout title="Article Categories" description="Browse articles by category.">
  <h1>Article Categories</h1>
  <p class="muted">Select a category to view related articles.</p>

  <div class="grid" style="margin-top: 1.5rem;">
    {categories.map(([category, count]) => {
      const { bg, text } = getCategoryColor(category);
      const icon = getCategoryIcon(category);
      return (
        <a class="card" href={`/articles/categories/${slugify(category)}/`} style={`border-left: 4px solid ${text};`}>
          <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span style={`display: inline-flex; color: ${text};`} set:html={icon}></span>
              <span style={`font-weight: 600; color: ${text};`}>{category}</span>
            </div>
            <p class="muted" style="margin-top: 0.5rem;">{count} articles</p>
          </div>
        </a>
      );
    })}
  </div>
</Layout>
