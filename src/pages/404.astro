---
import Layout from '../layouts/Layout.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Page Not Found',
  description: 'The page you are looking for does not exist or has been moved.',
};
---

<Layout
  title="Page Not Found"
  description="The page you are looking for does not exist or has been moved."
  noindex
  schema={schema}
>
  <div class="prose" style="text-align: center;">
    <h1>404</h1>
    <p style="font-size: 1.25rem; margin-bottom: 1.5rem;">
      Oops! The page you're looking for doesn't exist.
    </p>
    <p>
      It may have been moved, deleted, or you typed the URL incorrectly.
    </p>
    <p style="margin-top: 1.5rem;">
      <a href="/" class="btn" style="display: inline-block; padding: 0.75rem 1.5rem; background: #3b5bdb; color: white; text-decoration: none; border-radius: 0.5rem;">
        ← Go back home
      </a>
    </p>
  </div>
</Layout>
