---
import Layout from '../layouts/Layout.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Page Not Found',
  description: 'This page could not be found. Check the address or return to EduGlossary to browse technology terms and guides.',
};
---

<Layout
  title="Page Not Found"
  description="This page could not be found. Check the address or return to EduGlossary to browse technology terms and guides."
  noindex
  schema={schema}
>
  <div class="prose" style="text-align: center;">
    <h1>404</h1>
    <p style="font-size: 1.25rem; margin-bottom: 1.5rem;">
      Oops! The page you're looking for doesn't exist.
    </p>
    <p>
      It may have been moved, deleted, or you typed the URL incorrectly.
    </p>
    <p style="margin-top: 1.5rem;">
      <a href="/" class="btn" style="display: inline-block; padding: 0.75rem 1.5rem; background: var(--color-primary); color: white; text-decoration: none; border-radius: var(--radius-md); font-weight: 600;">
        ← Go back home
      </a>
    </p>
  </div>
</Layout>
