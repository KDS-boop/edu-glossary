---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { hubs } from '../../data/hubs';
import { getCategoryColor } from '../../utils/categoryColors';
import { getCategoryIcon } from '../../utils/categoryIcons';

// Map hub slugs to category names for colors/icons
const hubCategoryMap: Record<string, string> = {
  'blockchain': 'Blockchain',
  'cloud-computing': 'Cloud Computing',
  'software-development': 'Software Development',
  'cybersecurity': 'Cybersecurity',
  'ai-and-data': 'AI & Data',
};

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Learn', href: '/learn/' },
];
---
<Layout title="Learn" description="Explore technology topics — from blockchain and cybersecurity to AI and cloud computing.">
  <Breadcrumb items={breadcrumbs} />
  <h1>Learn</h1>
  <p class="muted">Explore technology topics organized into focused learning paths.</p>

  <div class="hub-grid">
    {hubs.map((hub) => {
      const catName = hubCategoryMap[hub.slug] || hub.title;
      const { bg, text } = getCategoryColor(catName);
      const icon = getCategoryIcon(catName);
      return (
        <a class="card hub-card" href={`/learn/${hub.slug}/`}>
          <div class="card-accent" style={`background: ${text};`}></div>
          <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
              <span style={`display: inline-flex; color: ${text};`} set:html={icon}></span>
              <span class="badge" style={`background: ${bg}; color: ${text};`}>{hub.glossarySlugs.length} terms</span>
            </div>
            <h2 class="hub-card-title">{hub.title}</h2>
            <p class="hub-card-desc">{hub.description}</p>
            <span class="card-readmore">
              Explore topic
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </span>
          </div>
        </a>
      );
    })}
  </div>
</Layout>

<style>
  .hub-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    margin-top: 2rem;
  }

  .hub-card {
    display: block;
    text-decoration: none;
  }

  .hub-card:hover {
    text-decoration: none;
  }

  .hub-card-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: var(--color-text);
  }

  .hub-card-desc {
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 768px) {
    .hub-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
